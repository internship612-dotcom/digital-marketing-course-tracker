# Copy to .env and fill in for a real deployment. Local development needs none of
# these — the API falls back to development defaults when NODE_ENV is not production.

# Required in production. The server refuses to start without it, because it signs
# every session token. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Password for the seeded `admin` account, applied only the first time that row is
# created. Without it, production seeds a random password and logs it once.
ADMIN_DEFAULT_PASSWORD=

DATABASE_URL=postgres://postgres:postgres@localhost:5433/course_tracker

# Optional — these have working defaults in the source.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_ADMIN_EMAIL=
